# Copy to .env and fill in. Only one API key is required.

# Provider: "openai" or "anthropic". If unset, it is detected from whichever key is present.
LLM_PROVIDER=

# API key. LLM_API_KEY takes precedence; OPENAI_API_KEY / ANTHROPIC_API_KEY also work.
LLM_API_KEY=

# Reply model and understanding (NLU) model. Leave empty for provider defaults.
LLM_MODEL=
NLU_MODEL=

# Optional: any OpenAI-compatible endpoint (Azure, OpenRouter, a local server...).
LLM_BASE_URL=

# Optional: reasoning effort for reasoning models (e.g. minimal / low / medium).
LLM_REASONING_EFFORT=

# Optional: date used for deadline checks, YYYY-MM-DD. Defaults to today.
AS_OF_DATE=

# Optional: require this passcode in the web UI (recommended for a public demo).
DEMO_PASSCODE=

# Optional: where the fixture JSON files live. Defaults to ./fixtures
FIXTURES_DIR=

# Policy knobs
OOS_THRESHOLD=3
MAX_VERIFICATION_ATTEMPTS=3
MAX_GATE_PUSHBACKS=3
MAX_CONSENT_CHECKS=3

# Which consent_scenarios.json entry manual chats simulate: default (approves) or timeout (never approves)
CONSENT_SCENARIO=default
